# NMHS-HMIS-V1.0 - environment variables (EXAMPLE ONLY - placeholders, no real values)
#
# The application reads the *process environment*; it does not load this file
# itself. On a server, copy it to a root-owned file (for example
# /etc/nmhs-hmis/hmis.env, mode 600) and load it with systemd's EnvironmentFile=.
# See docs/DEPLOYMENT.md. Never commit a filled-in copy: .env and .env.* are
# gitignored. Keep comments on their own lines: systemd does not strip a
# comment written after a value.

# --- environment -------------------------------------------------------------
# development (default): SQLite at backend/hmis/db.sqlite3, nothing else needed.
# production: every variable marked REQUIRED must be set, or the process refuses
# to start. There is no fallback to SQLite in production.
DJANGO_ENV=development

# --- core (REQUIRED in production) -------------------------------------------
# Production: 50+ random characters.
DJANGO_SECRET_KEY=change-me
# Production: False (true is refused).
DJANGO_DEBUG=True
# Production example: hmis.example-hospital.org,hmis-admin.example-hospital.org
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production example: https://hmis.example-hospital.org,https://hmis-admin.example-hospital.org
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL (REQUIRED in production; ignored in development) -------------
DB_NAME=hmis
DB_USER=hmis
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
#DB_CONN_MAX_AGE=60

# --- Redis / Celery (recommended in production) ------------------------------
# With a password: redis://:<password>@127.0.0.1:6379/0
REDIS_URL=redis://127.0.0.1:6379/0
# Optional; defaults to REDIS_URL.
#CACHE_URL=redis://127.0.0.1:6379/1

# --- HTTPS behind Nginx (production; the secure defaults are shown) ----------
#DJANGO_BEHIND_HTTPS_PROXY=true
#DJANGO_SECURE_SSL_REDIRECT=true
#DJANGO_SECURE_HSTS_SECONDS=31536000
#DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
#DJANGO_SECURE_HSTS_PRELOAD=false
# Same-origin production needs no CORS; if set, use the https:// staff origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- files -------------------------------------------------------------------
#DJANGO_STATIC_ROOT=/srv/nmhs-hmis/backend/hmis/staticfiles
#DJANGO_MEDIA_ROOT=/srv/nmhs-hmis/backend/hmis/media

# --- logging -----------------------------------------------------------------
# Default INFO in production, DEBUG in development.
#DJANGO_LOG_LEVEL=INFO
# Optional rotating log files; without it, logs go to stdout (journald).
#DJANGO_LOG_DIR=/var/log/nmhs-hmis
#DJANGO_LOG_MAX_BYTES=10485760
#DJANGO_LOG_BACKUPS=10
# One line per request; default on in production, off in development.
#DJANGO_REQUEST_LOG=true
# SQL logging: development only, ignored in production.
#DJANGO_SQL_DEBUG=false
TIME_ZONE=Africa/Lagos

# --- login rate limiting -----------------------------------------------------
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# --- transactional email (Resend; optional) ----------------------------------
# Leave RESEND_API_KEY blank and nothing is sent and nothing fails.
RESEND_API_KEY=
HMIS_EMAIL_FROM=hmis@your-hospital-domain
HMIS_ADMIN_EMAIL=administrator@your-hospital-domain
# Production: https://hmis.example-hospital.org
HMIS_BASE_URL=http://localhost:5173
#RESEND_TIMEOUT_SECONDS=10

# --- AI agents (optional; no screen uses them yet) ---------------------------
ANTHROPIC_API_KEY=
