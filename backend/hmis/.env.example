DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DB_NAME=hmis
DB_USER=hmis
DB_PASSWORD=hmis
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=sk-ant-...
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- transactional email (Resend) -------------------------------------------
# The admin notifications in apps/core/email.py. Leave these blank and nothing
# is sent and nothing fails — which is what a developer machine wants.
# Never commit a real key or a real address: this file is the example, and
# .env (which holds the real values) is gitignored.
RESEND_API_KEY=
HMIS_EMAIL_FROM=hmis@your-hospital-domain
HMIS_ADMIN_EMAIL=administrator@your-hospital-domain
# Where a link in an email points — the React app, not the API.
HMIS_BASE_URL=http://localhost:5173

# --- login rate limiting ----------------------------------------------------
# Four failed sign-ins are allowed; the fifth locks that client out of that
# username for this long. Defaults are the shipped rule.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
