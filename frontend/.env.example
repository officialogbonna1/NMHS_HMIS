# NMHS-HMIS-V1.0 frontend build variables (example only).
#
# Leave VITE_API_BASE_URL unset for local development: requests go to /api on
# the Vite dev server, which proxies them to Django on :8000.
#
# For a separately hosted frontend (Render Static Site), set it to the API's
# public origin, without /api and without a trailing slash. It is compiled into
# the public bundle: never put a secret in any VITE_* variable.
VITE_API_BASE_URL=
