# Railway (Railpack) only: how the built React app is served there. Render's
# static site and the Vite dev server ignore this file.
#
# Railpack's own default for a Vite app, plus the headers the Render static site
# sends (render.yaml): no framing, no MIME sniffing, same-origin referrer, HSTS
# (Railway's edge terminates HTTPS), and long caching for hashed assets.
# Unmatched paths fall back to index.html — the app's client-side routes.
{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8 # trust Railway's proxy
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	root * {{.DIST_DIR}}

	file_server {
		hide .git
		hide .env*
	}

	encode {
		gzip
		zstd
	}

	try_files {path} {path}.html {path}/index.html /index.html
}
